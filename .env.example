# Copy to .env and fill in. Set at least one cloud key; without one the copilot only transcribes.

# --- AI provider -------------------------------------------------------------
# The LLM at startup (switch live in the window header):
# gemini | claude | openai | grok | custom
LLM_PROVIDER=gemini

# Google Gemini (free tier: ~20 requests/day/model, too few for a meeting; enable billing)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# minimal | low | medium | high | off
GEMINI_THINKING=minimal

# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max | off  (low = fastest)
CLAUDE_EFFORT=low

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# xAI Grok
XAI_API_KEY=
GROK_MODEL=grok-4.7

# Any OpenAI-compatible endpoint: OmniRoute, OpenRouter, LiteLLM, LM Studio, vLLM ...
# CUSTOM_LABEL=OmniRoute
# CUSTOM_BASE_URL=http://localhost:20128/v1
# CUSTOM_MODEL=gh/gpt-5.1-codex
CUSTOM_LABEL=Custom
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# --- Assistant ---------------------------------------------------------------
# Proactive pacing: react after the participant paused this long (s), during a monologue at the
# latest after PROACTIVE_MAX_WAIT; a new card replaces the one on screen after SUGGESTION_READ_S.
PROACTIVE_PAUSE=1.5
PROACTIVE_MAX_WAIT=15
SUGGESTION_READ_S=10
# One suggestion per card instead of two, in a larger font
SINGLE_SUGGESTION=false
# Role: system (client/sales calls) | interview (job interviews, meetings at work)
PROMPT=system
# Extra knowledge files or folders to index, separated by ";" (.md and .json)
# KB_EXTRA_PATHS=C:/Users/me/Notes/Interview Prep.md;C:/Users/me/Notes/Company
KB_EXTRA_PATHS=

# --- Audio / speech ------------------------------------------------------------
# Device name substrings (see: uv run python -m copilot.devices); empty = system default
# (macOS: LOOPBACK_DEVICE defaults to BlackHole)
MIC_DEVICE=
LOOPBACK_DEVICE=
# STT engine: auto (WhisperKit on Apple Silicon, else faster-whisper) | faster-whisper | whisperkit
# WhisperKit needs Homebrew's whisperkit-cli (install.sh installs it); without it, or when it fails,
# the copilot falls back to faster-whisper and prints why. Details: README, "Speech recognition".
STT_ENGINE=auto
# WhisperKit STT model (argmaxinc/whisperkit-coreml ID, default large-v3-turbo); a model folder
# of your own; compute units for encoder and decoder: cpuAndGPU | cpuAndNeuralEngine | all | cpuOnly
# WHISPERKIT_MODEL=openai_whisper-large-v3-v20240930
# WHISPERKIT_MODEL_PATH=
# WHISPERKIT_COMPUTE_UNITS=cpuAndGPU
# whisperkit-cli leaks RAM with every request: once its server has grown this many GB past its size
# after warm-up, a warmed replacement takes over between two chunks (docs/adr/0001-recycle-whisperkit-server.md)
# WHISPERKIT_MAX_GROWTH_GB=1.5
# WHISPER_DEVICE/MODEL/COMPUTE apply to faster-whisper only (WHISPER_LANGUAGE to both engines).
# auto = large-v3-turbo/float16 on an NVIDIA GPU, small/int8 on the CPU.
# Too slow on your CPU? WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_MODEL=auto
WHISPER_COMPUTE=auto
# auto (one of LANGUAGES, sticky per speaker) | a fixed language code, e.g. de (skips detection)
WHISPER_LANGUAGE=auto
# Spoken languages, yours first (translation goes into it). Any Whisper language code works.
LANGUAGES=de,en
# Force the language of the suggestions and the meeting memory, e.g. en
# (empty = suggestions as the prompt says: German, or the interviewer's; memory in German)
REPLY_LANGUAGE=
# Show lines in these languages in Latin script (one LLM call per line), e.g. ur for Roman Urdu.
# Comma-separated; empty = off. Independent of translation.
TRANSLITERATE=
# Language of the window's own text (buttons, tooltips, hints, presets, status and error notes)
# and of the meeting record's headings: en | de. Was German before; set de to keep the German window.
UI_LANGUAGE=en
# Embedding model for your notes; for languages other than German/English use a multilingual one
# EMBEDDING_MODEL=intfloat/multilingual-e5-large
